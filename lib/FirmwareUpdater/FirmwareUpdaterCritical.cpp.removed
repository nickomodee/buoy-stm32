#include "FirmwareUpdater.h"

#define PAGE_ALIGN_LEFT(addr)    (((addr)) & ~(FLASH_PAGE_SIZE - 1)) // only works for powers of 2
#define PAGE_ALIGN_RIGHT(addr)   ((((addr)) + (FLASH_PAGE_SIZE - 1)) & ~(FLASH_PAGE_SIZE - 1)) // only works for powers of 2

const char __FIRMWARE_RODATA firmware_update_path[] = "fw.bin";
const char __FIRMWARE_RODATA new_firmware_path[] = "fw_new.bin";
const char __FIRMWARE_RODATA firmware_update_size_path[] = "fw_size.bin";
const char __FIRMWARE_RODATA firmware_update_checksum_path[] = "checksum.bin";
const char __FIRMWARE_RODATA firmware_update_available_path[] = "avail.txt";
constexpr const char __FIRMWARE_RODATA update_is_available_indicator_byte = '1';
constexpr const uint8_t __FIRMWARE_RODATA update_checksum_size = sizeof(firmware_checksum_type);
constexpr const uint8_t __FIRMWARE_RODATA update_size_size = sizeof(firmware_size_type);
constexpr const uint8_t __FIRMWARE_RODATA firmware_update_retries = 16;

bool __FIRMWARE FirmwareUpdater::flash_erase_page_(const uint32_t address) {
    uint32_t page_start_address = address & ~(FLASH_PAGE_SIZE - 1);
    uint32_t offset = address - page_start_address;
    bool success = true;

    // Unlock flash control register
    FLASH->KEYR = 0x45670123; // Unlock key 1
    FLASH->KEYR = 0xCDEF89AB; // Unlock key 2

    // Wait for the flash to be ready
    while (FLASH->SR & FLASH_SR_BSY);

    if (offset == 0) { // if it is page-aligned we don't need to write anything and just erase
        // Set the page erase bit
        FLASH->CR |= FLASH_CR_PER;

        // Set the page address
        FLASH->AR = page_start_address;

        // Start the erase operation
        FLASH->CR |= FLASH_CR_STRT;

        // Wait for the erase operation to complete
        while (FLASH->SR & FLASH_SR_BSY);
        // Check for errors
        if (FLASH->SR & (FLASH_SR_PGERR | FLASH_SR_WRPERR)) {
            FLASH->SR |= (FLASH_SR_PGERR | FLASH_SR_WRPERR); // Clear error flags
            success = false;
        }

        // Clear the page erase bit
        FLASH->CR &= ~FLASH_CR_PER;
    } else { // address is not page-aligned
        uint8_t page_buffer[FLASH_PAGE_SIZE];

        // read the whole page into the buffer
        memcpy(page_buffer, (uint8_t *)page_start_address, FLASH_PAGE_SIZE);

        // only erase from `address` onwards
        memset(page_buffer + offset, 0xFF, FLASH_PAGE_SIZE - offset); // the erased bytes are 0xff

        // Erase the page
        FLASH->CR |= FLASH_CR_PER;
        FLASH->AR = page_start_address;
        FLASH->CR |= FLASH_CR_STRT;

        // Wait for the erase operation to complete
        while (FLASH->SR & FLASH_SR_BSY);

        // Check for errors
        if (FLASH->SR & (FLASH_SR_PGERR | FLASH_SR_WRPERR)) {
            FLASH->SR |= (FLASH_SR_PGERR | FLASH_SR_WRPERR); // Clear error flags
            success = false;
        }

        // Clear the page erase bit
        FLASH->CR &= ~FLASH_CR_PER;

        if (success) {
            // Enable programming mode
            FLASH->CR |= FLASH_CR_PG;

            uint32_t program_address = page_start_address;
            uint16_t *data = (uint16_t *)page_buffer;
            uint32_t num_halfwords = FLASH_PAGE_SIZE / 2; // stm32f303k8 uses halfwords ffs

            for (uint32_t i = 0; i < num_halfwords; i++) {
                *(__IO uint16_t*)program_address = data[i];

                // Wait for the operation to complete
                while (FLASH->SR & FLASH_SR_BSY);

                // Check for errors
                if (FLASH->SR & (FLASH_SR_PGERR | FLASH_SR_WRPERR)) {
                    FLASH->SR |= (FLASH_SR_PGERR | FLASH_SR_WRPERR); // Clear error flags
                    FLASH->CR &= ~FLASH_CR_PG; // Disable programming mode
                    FLASH->CR |= FLASH_CR_LOCK; // Lock flash
                    return false;
                }

                if (*(uint16_t*)program_address != data[i]) { // verify
                    success = false;
                    break;
                }

                program_address += 2;
            }

            // Disable programming mode
            FLASH->CR &= ~FLASH_CR_PG;
        }
    }
    
    // Lock flash
    FLASH->CR |= FLASH_CR_LOCK;

    return success;
}

bool __FIRMWARE FirmwareUpdater::flash_write_byte_(uint32_t address, uint16_t data) { // stm32f303k8 uses halfwords...
    if (address % 2 != 0) { // address must be 16-bit aligned
        return false;
    }

    // Unlock flash control register
    FLASH->KEYR = 0x45670123; // Unlock key 1
    FLASH->KEYR = 0xCDEF89AB; // Unlock key 2

    // Wait for the flash to be ready
    while (FLASH->SR & FLASH_SR_BSY);

    // Enable programming mode
    FLASH->CR |= FLASH_CR_PG;

    *(__IO uint16_t*)address = data;

    // Wait for the operation to complete
    while (FLASH->SR & FLASH_SR_BSY);

    // Check for errors
    if (FLASH->SR & (FLASH_SR_PGERR | FLASH_SR_WRPERR)) {
        FLASH->SR |= (FLASH_SR_PGERR | FLASH_SR_WRPERR); // Clear error flags
        FLASH->CR &= ~FLASH_CR_PG; // Disable programming mode
        FLASH->CR |= FLASH_CR_LOCK; // Lock flash
        return false;
    }

    // Disable programming mode
    FLASH->CR &= ~FLASH_CR_PG;

    // Lock flash
    FLASH->CR |= FLASH_CR_LOCK;

    return true;
}

firmware_checksum_type __FIRMWARE FirmwareUpdater::calculate_flash_firmware_checksum_(const uint32_t start_flash_address, const uint32_t end_flash_address) { // `flash_end_address` is the next byte after
    firmware_checksum_type flash_checksum = 0;
    for (uint32_t flash_address = start_flash_address; flash_address < end_flash_address; flash_address++) {
        flash_checksum += *((uint8_t*)flash_address);
    }
    return flash_checksum;
}

void __FIRMWARE FirmwareUpdater::begin_() {
    SD_File firmware_update_checksum_file{firmware_update_checksum_path};
    if (!firmware_update_checksum_file.open(FA_READ)) {
        return;
    }
    if (firmware_update_checksum_file.get_size() != update_checksum_size) {
        return;
    }
    firmware_checksum_type expected_firmware_checksum = 0;
    int checksum_byte;
    for (uint8_t i = 0; i < update_checksum_size; i++) {
        checksum_byte = firmware_update_checksum_file.read();
        if (checksum_byte == -1) {
            return;
        }
        expected_firmware_checksum |= (uint8_t)checksum_byte << (i * 8); // little endian format
    }
    firmware_update_checksum_file.close();

    SD_File firmware_file{firmware_update_path};
    if (!firmware_file.open(FA_READ)) {
        return;
    }

    const firmware_size_type firmware_update_size = firmware_file.get_size();

    const uint32_t flash_update_start_address = (uint32_t)&_flash_update_start; // this MUST be the same across all firmwares and SHOULD REALLY also be page aligned (so that we can utilise as much space as possible for updates)
    const uint32_t flash_update_end_address = (uint32_t)&_flash_update_end; // this MUST be the same across all firmwares and SHOULD REALLY also be page aligned (so that we can utilise as much space as possible for updates)

    const uint32_t flash_update_start_page_aligned_address = PAGE_ALIGN_LEFT(flash_update_start_address);
    const uint32_t flash_update_end_page_aligned_address = PAGE_ALIGN_RIGHT(flash_update_end_address);

    STM32_INTERRUPT_GUARD interrupt_guard; // really important because we are overwriting the current isr table
    
    const uint32_t firmware_end_address = FLASH_BASE + firmware_update_size; // the byte after the end

    for (uint8_t i = 0; i < firmware_update_retries; i++) {
        for (uint32_t flash_address = FLASH_BASE; flash_address < firmware_end_address; flash_address += 2) {
            if (flash_address >= flash_update_start_page_aligned_address && flash_address < flash_update_end_page_aligned_address) {
                continue;
            }

            if ((flash_address % FLASH_PAGE_SIZE) == 0) {
                if (!FirmwareUpdater::flash_erase_page_(flash_address)) {
                    return;
                }
            }

            int firmware_byte = firmware_file.read();
            if (firmware_byte == -1) {
                return;
            }
            const uint8_t firmware_byte_1 = (uint8_t)firmware_byte;
            uint8_t firmware_byte_2 = 0xFF;
            if (flash_address < firmware_end_address - 1) { // since we increment in 2s we may cause a read on a file with no more contents
                firmware_byte = firmware_file.read();
                if (firmware_byte == -1) {
                    return;
                }
                firmware_byte_2 = (uint8_t)firmware_byte;
            }

            const uint16_t firmware_halfword = ((uint16_t)firmware_byte_2 << 8U) | (uint16_t)firmware_byte_1;

            if (!FirmwareUpdater::flash_write_byte_(flash_address, firmware_halfword)) {
                return;
            }
        }

        const firmware_checksum_type firmware_checksum = calculate_flash_firmware_checksum_(FLASH_BASE, firmware_end_address);
        if (firmware_checksum == expected_firmware_checksum) {
            end_(); // reset
            return; // won't reach here
        }
    }

    return;
}

void __FIRMWARE FirmwareUpdater::mcu_reset_() {
    __disable_irq();
    NVIC_SystemReset();
}


void __FIRMWARE FirmwareUpdater::end_() {
    sd.remove(firmware_update_available_path);
    mcu_reset_();
}